# Copia este archivo como .env y pon tu clave real. El .env está en .gitignore.
# Se obtiene gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo de Gemma 4 hospedado en la Gemini API.
# Alternativa: gemma-4-26b-a4b-it (MoE, más barato en cómputo).
GEMMA_MODELO=gemma-4-31b-it

# Pon 1 para trabajar el frontend con respuestas simuladas y no gastar cuota.
LIVY_FAKE_GEMMA=0

# El tier gratuito son 15 solicitudes por minuto; dejamos margen.
LIVY_LIMITE_RPM=13

# Dominios permitidos por CORS, separados por coma. * para la demo pública.
CORS_ORIGENES=*
